# Copy to server/.env and edit for your environment.
#   cp .env.example server/.env

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_management?schema=public"

# Signs access and refresh tokens. Use a long random value in production:
#   openssl rand -hex 32
JWT_SECRET="change-me-before-deploying"

# API port.
PORT=3001

# Allowed CORS origin (the frontend).
CLIENT_URL="http://localhost:5173"

# development | production | test
NODE_ENV=development

# Optional. Only used by the test suite. Its name must contain "test" — the suite
# truncates every table between tests and refuses to run against anything else.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_management_test?schema=public"

# ---------------------------------------------------------------------------
# Frontend build-time variables. Copy to client/.env (they are baked into the
# bundle at build time, so never put secrets here).
# ---------------------------------------------------------------------------

# Base URL of the API. Leave unset in development to use the Vite proxy.
# VITE_API_URL="https://your-api.example.com/api"

# Public address of the customer-facing site. Used to build the table QR codes
# in Admin -> Mesas. Set this whenever the admin console is opened on a host
# customers cannot reach (localhost, a LAN address, a preview deploy) —
# otherwise the printed QR codes point somewhere no phone can open.
# VITE_PUBLIC_URL="https://your-cafe.example.com"
